# DealFlow360 — normalize line endings across Windows/Mac/Linux teammates
# -----------------------------------------------------------------------
# All text files: LF in repo, CRLF on Windows checkout (autocrlf handles this)
* text=auto eol=lf

# Explicitly mark these as always-LF
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.prisma text eol=lf
*.sql  text eol=lf
*.sh   text eol=lf

# Binary files — never touch
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
