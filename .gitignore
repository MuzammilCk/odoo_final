# ============================================
# DealFlow360 — .gitignore
# TypeScript Monorepo: React+Vite / Node+Express / Prisma / PostgreSQL
# ============================================

# ---------- Dependencies ----------
node_modules/
.pnp
.pnp.js

# ---------- Build outputs ----------
dist/
build/
out/
*.tsbuildinfo

# ---------- Environment ----------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Keep the example
!.env.example

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- OS files ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo
*~

# ---------- IDE / Editor ----------
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# ---------- Vite ----------
*.local

# ---------- Testing ----------
coverage/
.nyc_output/

# ---------- Prisma ----------
# Migrations are tracked — do NOT ignore prisma/migrations/
# Generated client is auto-generated at install
prisma/generated/

# ---------- Misc ----------
*.pid
*.seed
*.pid.lock
.cache/
tmp/
temp/
